# Copy to backend/.env (or export in your shell). Never commit real values.
# Every variable below is read by backend/app/core/config.py.

# --- Application ---------------------------------------------------------------------------
APP_ENV=development                 # development | test | production
APP_SECRET_KEY=replace_with_a_random_secret   # >= 32 random chars is REQUIRED when APP_ENV=production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173  # comma-separated list of allowed browser origins

# --- MongoDB (local or Atlas: use the mongodb+srv:// URI) ----------------------------------
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=lumina_ai_tutor

# --- Groq LLM (model is pinned; any other value is rejected at startup) --------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2500

# --- Embeddings / vector store -------------------------------------------------------------
# EMBEDDING_PROVIDER: google (semantic, needs GOOGLE_API_KEY) | hash (offline lexical, dev/test only) | empty = RAG disabled
EMBEDDING_PROVIDER=
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
# VECTOR_STORE_PROVIDER: mongo (embeddings stored in MongoDB chunks collection) | empty = RAG disabled
VECTOR_STORE_PROVIDER=

# --- RAG -----------------------------------------------------------------------------------
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_MIN_SCORE=0.15
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=300

# --- Usage limits and subscription plans ---------------------------------------------------
USER_MONTHLY_TOKEN_LIMIT=250000     # Free plan allowance; paid plans below
PLAN_PRO_MONTHLY_TOKEN_LIMIT=1000000
PLAN_PREMIUM_MONTHLY_TOKEN_LIMIT=5000000
PLAN_PRO_PRICE_INR=499
PLAN_PREMIUM_PRICE_INR=1499
PLAN_DURATION_DAYS=30

# --- Agent workflow budgets ----------------------------------------------------------------
MAX_AGENT_STEPS=6
MAX_TOOL_CALLS=4
MAX_RETRIES=2
CONVERSATION_HISTORY_LIMIT=12
MAX_INPUT_CHARS=4000
MAX_OUTPUT_CHARS=12000
WORKFLOW_TIMEOUT_SECONDS=90
WORKFLOW_TOKEN_BUDGET=12000
MIN_TOKEN_RESERVE=1500

# --- Memory --------------------------------------------------------------------------------
MEMORY_ENABLED=true
MEMORY_RETRIEVAL_LIMIT=5

# --- Razorpay (test-mode keys for development) ---------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# --- Langfuse (optional; status reporting only - trace delivery is NOT implemented) ---------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Rate limiting -------------------------------------------------------------------------
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
API_RATE_LIMIT_PER_MINUTE=120
